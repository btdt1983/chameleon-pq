# Rust build artifacts
/target/
/dist/
**/*.rs.bk

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# === SECURITY: never commit secrets ===
# Real configs with private keys/seeds (only the example may be tracked)
config.toml
config*.toml
# Catch any config with private keys regardless of prefix (e.g. client-config-pq.toml)
*config*.toml
!config.example.toml

# Sleutel-bestanden in elke vorm
*.key
*.pem
*.seed
*_secret*
*_private*

# Native libs kept locally for the Windows bundle (never commit/publish these).
# wintun.dll is redistributed via the GitHub release, not the crate.
*.dll

# Local environment overrides
.env
.env.local

# Android app build artifacts / local toolchain state. `android/rust-jni`'s
# own Cargo.lock stays TRACKED (matches gui/ and fuzz/ — this is not a
# workspace member, so it needs its own lockfile committed).
/android/rust-jni/target/
/android/.gradle/
/android/.kotlin/
/android/**/build/
/android/local.properties
*.jks
*.keystore
# The built .so is Phase D's regenerated build output (see android/README.md)
# — never commit it, so a stale binary can never silently ship.
/android/app/src/main/jniLibs/

# Ad-hoc screenshots dropped at the repo root during debugging (e.g. speed-test
# results shared in chat) — root-anchored so it does NOT affect the real,
# tracked images that belong in the repo (docs/screenshot.jpg,
# gui/assets/*.png/*.ico). Without this, cargo's default "everything not
# gitignored" packaging rule would sweep a stray screenshot into the
# published crate.
/*.jpg
/*.JPG
/*.jpeg
/*.JPEG
/*.png
/*.PNG
